# ===== 应用 =====
APP_ENV=dev
APP_TITLE=知策 · 政策知识问答助手
LOG_LEVEL=INFO
LOG_DIR=logs

# ===== 安全 =====
# 生产环境务必修改为随机长字符串
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
# 管理员种子账号（首次启动时创建；密码至少 8 位）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# ===== MySQL =====
# 本地 docker-compose 默认值；如使用已有 MySQL，请改成自己的连接串
DATABASE_URL=mysql+pymysql://rag:rag@127.0.0.1:3306/enterprise_rag?charset=utf8mb4
AUTO_CREATE_TABLES=true

# ===== Milvus =====
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=kb_chunks

# ===== bge-m3 本地编码 =====
EMBEDDING_PROVIDER=bge_m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_LENGTH=1024
EMBEDDING_CACHE_DIR=data/models
EMBEDDING_PRELOAD=true
# 国内网络下载慢时可取消注释
# HF_ENDPOINT=https://hf-mirror.com

# ===== DeepSeek =====
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=disabled
LLM_TIMEOUT_S=120

# ===== 检索与生成 =====
TOP_K=5
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=0.8
DEFAULT_MAX_TOKENS=2048
DEFAULT_HISTORY_ROUNDS=5
MAX_HISTORY_ROUNDS=20
HISTORY_MAX_CHARS=6000

# ===== 上传与验证码 =====
MAX_UPLOAD_MB=50
UPLOAD_DIR=data/uploads
CAPTCHA_TTL_SECONDS=300

# ===== 其他 =====
CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
ENABLE_WORKER=true
