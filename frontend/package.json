{
  "name": "enterprise-rag-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "api:types": "openapi-typescript ../docs/openapi.json -o src/api/generated/schema.d.ts",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "dompurify": "^3.2.4",
    "element-plus": "^2.9.3",
    "markdown-it": "^14.1.0",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.13"
  }
}
